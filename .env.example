# Copy to .env and fill in. .env is gitignored — never commit real keys.
OPENROUTER_API_KEY=

# Model for the reasoning agents (Content Forensics' detector, Ring Detector's
# cluster verifier, the Adjudicator's arbiter). One variable re-points all
# three. Default: openai/gpt-5-nano.
REASONING_MODEL=

# Reasoning models spend their token budget on hidden reasoning before writing
# anything. gpt-5-nano with a 300-token cap returned an EMPTY completion after
# burning 1,152 reasoning tokens — billed, and useless. "minimal" turns that
# off; models without a reasoning mode ignore the field. Set to an empty
# string to stop sending it at all.
REASONING_EFFORT=minimal

# Fallback model for any spine.llm call that does not pass one explicitly.
OPENROUTER_MODEL=

# Every agent also runs with --no-llm and needs no key at all; the headline
# precision/recall figures in the README are produced that way.
