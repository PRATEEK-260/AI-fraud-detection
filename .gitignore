data/raw/*
data/processed/*
data/llm_cache/
*.db

# ...but ship the small artifacts a judge needs to run this without first
# downloading 645MB from Kaggle: the audit log (so the dashboard opens with
# real cases), the self-built Content Forensics corpus, and the frozen-split
# provenance. The large raw datasets stay out; README has the download step.
!data/cases.db
!data/processed/content_forensics_labeled.csv
!data/processed/split_summary.json
!data/processed/checkout_sessions.parquet

# The 240 specimen document images (12MB) are NOT committed: they regenerate
# deterministically from a seed in seconds with no downloads and no API key
# (scripts/make_documents.py). Shipping them would triple the repo for no
# reproducibility gain.
__pycache__/
.env
.venv/

# tests
.pytest_cache/
